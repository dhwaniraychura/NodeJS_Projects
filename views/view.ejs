<%- include('partials/header', { pageTitle: book.title }) %>

<main class="container view-page">
  <a href="/" class="back-link">← Back to Dashboard</a>

  <div class="book-detail">
    <div class="book-detail-cover">
      <% if (book.image) { %>
        <img src="<%= book.image %>" alt="<%= book.title %>" />
      <% } else { %>
        <div class="no-cover-large">📖</div>
      <% } %>
    </div>

    <div class="book-detail-info">
      <span class="book-category large"><%= book.category %></span>
      <h1 class="book-detail-title"><%= book.title %></h1>
      <p class="book-detail-author">by <strong><%= book.author %></strong></p>

      <div class="detail-grid">
        <div class="detail-item">
          <span class="detail-label">Price</span>
          <span class="detail-value price-large">₹<%= book.price.toLocaleString('en-IN') %></span>
        </div>
        <div class="detail-item">
          <span class="detail-label">Quantity</span>
          <span class="detail-value"><%= book.quantity %> copies</span>
        </div>
        <div class="detail-item">
          <span class="detail-label">Status</span>
          <span class="badge badge-<%= book.quantity > 0 ? 'available' : 'sold' %> inline">
            <%= book.quantity > 0 ? 'In Stock' : 'Out of Stock' %>
          </span>
        </div>
        <div class="detail-item">
          <span class="detail-label">Added On</span>
          <span class="detail-value"><%= book.createdAt.toLocaleDateString('en-IN', { day:'numeric', month:'long', year:'numeric' }) %></span>
        </div>
      </div>

      <% if (book.description) { %>
        <div class="book-description">
          <h3>Description</h3>
          <p><%= book.description %></p>
        </div>
      <% } %>

      <div class="detail-actions">
        <a href="/books/<%= book._id %>/edit" class="btn btn-primary">✏️ Edit Book</a>
        <form method="POST" action="/books/<%= book._id %>?_method=DELETE"
              onsubmit="return confirmDelete(event)">
          <button type="submit" class="btn btn-danger">🗑️ Delete Book</button>
        </form>
      </div>
    </div>
  </div>
</main>

<%- include('partials/footer') %>
