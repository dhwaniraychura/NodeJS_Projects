<%- include('partials/header', { pageTitle: 'Dashboard' }) %>

<main class="container">

  <!-- Stats Bar -->
  <section class="stats-bar">
    <div class="stat-card">
      <span class="stat-icon">📚</span>
      <div>
        <p class="stat-label">Total Books</p>
        <p class="stat-value"><%= totalBooks %></p>
      </div>
    </div>
    <div class="stat-card">
      <span class="stat-icon">🗂️</span>
      <div>
        <p class="stat-label">Categories</p>
        <p class="stat-value"><%= categories.length - 1 %></p>
      </div>
    </div>
  </section>

  <!-- Alerts -->
  <% if (success) { %>
    <div class="alert alert-success">✅ <%= success %></div>
  <% } %>
  <% if (error) { %>
    <div class="alert alert-error">❌ <%= error %></div>
  <% } %>

  <!-- Filters -->
  <section class="filter-bar">
    <form method="GET" action="/" class="search-form">
      <input type="text" name="search" placeholder="🔍 Search by title or author..."
             value="<%= search %>" class="search-input" />
      <button type="submit" class="btn btn-primary">Search</button>
      <a href="/" class="btn btn-ghost">Clear</a>
    </form>
    <a href="/books/add" class="btn btn-add">+ Add New Book</a>
  </section>

  <!-- Books Grid -->
  <% if (books.length === 0) { %>
    <div class="empty-state">
      <p class="empty-icon">📭</p>
      <h2>No books found</h2>
      <p>Start building your collection by adding a book.</p>
    </div>
  <% } else { %>
    <div class="books-grid">
      <% books.forEach(book => { %>
        <article class="book-card">
          <div class="book-cover">
            <% if (book.image) { %>
              <img src="<%= book.image %>" alt="<%= book.title %>" />
            <% } else { %>
              <div class="no-cover">📖</div>
            <% } %>
          </div>
          <div class="book-info">
            <span class="book-category"><%= book.category %></span>
            <h3 class="book-title"><%= book.title %></h3>
            <p class="book-author">by <%= book.author %></p>
            <div class="book-meta">
              <span class="price">₹<%= book.price.toLocaleString('en-IN') %></span>
              <span class="quantity">Qty: <%= book.quantity %></span>
            </div>
            <div class="book-actions">
              <a href="/books/<%= book._id %>" class="btn btn-sm btn-view">View</a>
              <a href="/books/<%= book._id %>/edit" class="btn btn-sm btn-edit">Edit</a>
              <form method="POST" action="/books/<%= book._id %>?_method=DELETE"
                    onsubmit="return confirmDelete(event)">
                <button type="submit" class="btn btn-sm btn-delete">Delete</button>
              </form>
            </div>
          </div>
        </article>
      <% }) %>
    </div>
  <% } %>

</main>
