<%- include('partials/header', { pageTitle: 'Edit Book' }) %>

<main class="container form-page">
  <div class="form-header">
    <a href="/" class="back-link">← Back to Dashboard</a>
    <h1>Edit Book</h1>
    <p>Update the details for <strong><%= book.title %></strong>.</p>
  </div>

  <% if (error) { %>
    <div class="alert alert-error">❌ <%= error %></div>
  <% } %>

  <form class="book-form" method="POST" action="/books/<%= book._id %>?_method=PUT" enctype="multipart/form-data">

    <div class="form-grid">
      <!-- Title -->
      <div class="form-group span-2">
        <label for="title">Book Title <span class="required">*</span></label>
        <input type="text" id="title" name="title" value="<%= book.title %>" required maxlength="200" />
      </div>

      <!-- Author -->
      <div class="form-group">
        <label for="author">Author Name <span class="required">*</span></label>
        <input type="text" id="author" name="author" value="<%= book.author %>" required maxlength="100" />
      </div>

      <!-- Category -->
      <div class="form-group">
        <label for="category">Category <span class="required">*</span></label>
        <select id="category" name="category" required>
          <% ['Fiction','Non-Fiction','Science','Technology','Finance','Self-Help',
              'Biography','History','Children','Comics','Romance','Mystery','Other'].forEach(cat => { %>
            <option value="<%= cat %>" <%= book.category === cat ? 'selected' : '' %>><%= cat %></option>
          <% }) %>
        </select>
      </div>

      <!-- Price -->
      <div class="form-group">
        <label for="price">Price (₹) <span class="required">*</span></label>
        <input type="number" id="price" name="price" value="<%= book.price %>" required min="0" step="0.01" />
      </div>

      <!-- Quantity -->
      <div class="form-group">
        <label for="quantity">Quantity <span class="required">*</span></label>
        <input type="number" id="quantity" name="quantity" value="<%= book.quantity %>" required min="0" />
      </div>

      <!-- Description -->
      <div class="form-group span-2">
        <label for="description">Description</label>
        <textarea id="description" name="description" rows="4" maxlength="1000"><%= book.description || '' %></textarea>
      </div>

      <!-- Image -->
      <div class="form-group span-2">
        <label>Book Cover Image</label>
        <% if (book.image) { %>
          <div class="current-image">
            <img src="<%= book.image %>" alt="Current cover" class="current-cover" />
            <p class="current-image-label">Current cover — upload a new one to replace</p>
          </div>
        <% } %>
        <div class="file-upload-area" id="dropArea">
          <input type="file" id="image" name="image" accept="image/*" class="file-input" />
          <div class="file-upload-label">
            <span class="upload-icon">🖼️</span>
            <p><%= book.image ? 'Upload new cover to replace existing' : 'Click or drag & drop' %></p>
            <small>JPEG, PNG, GIF, WebP — Max 5 MB</small>
          </div>
          <img id="imagePreview" class="image-preview hidden" alt="Preview" />
        </div>
      </div>
    </div>

    <div class="form-actions">
      <a href="/" class="btn btn-ghost">Cancel</a>
      <button type="submit" class="btn btn-primary">✏️ Update Book</button>
    </div>
  </form>
</main>

<%- include('partials/footer') %>
