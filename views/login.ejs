<%- include('partials/head') %>
<%- include('partials/navbar') %>

<div class="auth-wrapper">
  <div class="form-card narrow">
    <div class="auth-icon">🍳</div>
    <h1>Welcome Back</h1>
    <p class="subtitle">Sign in to access your recipes and saved dishes.</p>

    <% if (error) { %>
      <div class="alert"><%= error %></div>
    <% } %>

    <form action="/login" method="POST">
      <div class="form-group">
        <label for="username">Username</label>
        <input type="text" id="username" name="username" placeholder="your-username" required autofocus>
      </div>

      <div class="form-group">
        <label for="password">Password</label>
        <input type="password" id="password" name="password" placeholder="••••••••" required>
      </div>

      <button type="submit" class="btn btn-primary btn-block">Sign In</button>
    </form>

    <p class="form-footer">New to The Hearth Book? <a href="/register">Create an account</a></p>
  </div>
</div>

<%- include('partials/footer') %>
