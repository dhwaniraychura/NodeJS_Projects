<%- include('partials/head') %>
<%- include('partials/navbar') %>

<div class="container">
  <div class="page-header">
    <div>
      <span class="eyebrow">The Collection</span>
      <h1>All Recipes</h1>
      <p>A shared pantry of dishes from every cook on The Hearth Book — browse, save, and get cooking.</p>
    </div>
    <% if (user) { %>
      <a href="/recipes/new" class="btn btn-primary">+ Add a Recipe</a>
    <% } %>
  </div>

  <% if (recipes.length === 0) { %>
    <div class="empty-state">
      <h3>The pantry is empty</h3>
      <p>No recipes have been shared yet. Be the first to add one!</p>
      <% if (user) { %>
        <a href="/recipes/new" class="btn btn-primary">+ Add a Recipe</a>
      <% } else { %>
        <a href="/login" class="btn btn-primary">Login to Add a Recipe</a>
      <% } %>
    </div>
  <% } else { %>
    <div class="recipe-grid">
      <% recipes.forEach(recipe => { %>
        <div class="recipe-card">
          <img src="<%= recipe.image %>" alt="<%= recipe.title %>" class="recipe-card-image" onerror="this.src='/images/default-recipe.svg'">
          <div class="recipe-card-body">
            <span class="recipe-category"><%= recipe.category %></span>
            <h3><%= recipe.title %></h3>
            <p class="desc"><%= recipe.description %></p>
            <div class="recipe-meta">
              <span>By <span class="author"><%= recipe.author ? recipe.author.username : 'Unknown' %></span></span>
              <span>⏱ <%= recipe.cookingTime %></span>
            </div>
            <div class="recipe-card-actions">
              <a href="/recipes/<%= recipe._id %>" class="btn btn-secondary btn-sm btn-block">View Recipe</a>
            </div>
          </div>
        </div>
      <% }) %>
    </div>
  <% } %>
</div>

<%- include('partials/footer') %>
