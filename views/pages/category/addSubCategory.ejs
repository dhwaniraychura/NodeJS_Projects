<%- include('../../partials/header') %>
<%- include('../../partials/navbar') %>
<div class="page-body-wrapper">
  <%- include('../../partials/sidebar') %>
  <div class="main-panel">
    <div class="content-wrapper">
      <div class="page-header">
        <h3 class="page-title">
          <span class="page-title-icon bg-gradient-primary text-white me-2">
            <i class="mdi mdi-shape-plus"></i>
          </span> Add SubCategory
        </h3>
        <nav aria-label="breadcrumb">
          <ol class="breadcrumb">
            <li class="breadcrumb-item"><a href="/">Home</a></li>
            <li class="breadcrumb-item"><a href="/category/view">Categories</a></li>
            <li class="breadcrumb-item active" aria-current="page">Add SubCategory</li>
          </ol>
        </nav>
      </div>

      <div class="row">
        <div class="col-md-7 grid-margin stretch-card">
          <div class="card">
            <div class="card-body">
              <h4 class="card-title">Add New SubCategory</h4>
              <p class="card-description">Fill in the details below</p>
              <form action="/category/subcategory/add" method="post" class="forms-sample">
                <div class="form-group">
                  <label>Select Category</label>
                  <select name="categoryId" class="form-control form-select" required>
                    <option value="">-- Select Category --</option>
                    <% categories.forEach(category => { %>
                      <option value="<%= category._id %>"><%= category.categoryName %></option>
                    <% }) %>
                  </select>
                </div>
                <div class="form-group">
                  <label>SubCategory Name</label>
                  <input type="text" class="form-control" name="subCategoryName" placeholder="Enter SubCategory Name" required>
                </div>
                <button type="submit" class="btn btn-gradient-primary me-2">Add SubCategory</button>
                <a href="/category/view" class="btn btn-light">Cancel</a>
              </form>
            </div>
          </div>
        </div>
      </div>
    </div>
    <%- include('../../partials/footer') %>
  </div>
</div>
