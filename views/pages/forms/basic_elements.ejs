<%- include('../../partials/header') %>
<%- include('../../partials/sidebar') %>
<%- include('../../partials/navbar') %>

<div class="main-panel">
  <div class="content-wrapper">

    <div class="page-header">
      <% if (typeof user !== 'undefined' && user) { %>
        <h3 class="page-title">Edit User</h3>
      <% } else { %>
        <h3 class="page-title">Add User</h3>
      <% } %>
      <nav aria-label="breadcrumb">
        <ol class="breadcrumb">
          <li class="breadcrumb-item"><a href="/users/view">Users</a></li>
          <li class="breadcrumb-item active">
            <%= (typeof user !== 'undefined' && user) ? 'Edit User' : 'Add User' %>
          </li>
        </ol>
      </nav>
    </div>

    <div class="row">
      <div class="col-md-8 grid-margin stretch-card">
        <div class="card">
          <div class="card-body">
            <h4 class="card-title">
              <%= (typeof user !== 'undefined' && user) ? 'Update User Details' : 'User Details' %>
            </h4>
            <p class="card-description">
              <% if (typeof user !== 'undefined' && user) { %>
                Editing: <strong><%= user.fname %> <%= user.lname %></strong>
              <% } else { %>
                Fill in the form below to add a new user.
              <% } %>
            </p>

            <% if (typeof user !== 'undefined' && user) { %>
              <!-- EDIT FORM -->
              <form action="/users/update/<%= user._id %>" method="POST" enctype="multipart/form-data" class="forms-sample">
            <% } else { %>
              <!-- ADD FORM -->
              <form action="/users/add" method="POST" enctype="multipart/form-data" class="forms-sample">
            <% } %>

              <div class="form-group row">
                <label class="col-sm-3 col-form-label">First Name</label>
                <div class="col-sm-9">
                  <input type="text" name="fname" class="form-control" placeholder="First name"
                    value="<%= (typeof user !== 'undefined' && user) ? user.fname : '' %>" required>
                </div>
              </div>

              <div class="form-group row">
                <label class="col-sm-3 col-form-label">Last Name</label>
                <div class="col-sm-9">
                  <input type="text" name="lname" class="form-control" placeholder="Last name"
                    value="<%= (typeof user !== 'undefined' && user) ? user.lname : '' %>" required>
                </div>
              </div>

              <div class="form-group row">
                <label class="col-sm-3 col-form-label">Email</label>
                <div class="col-sm-9">
                  <input type="email" name="email" class="form-control" placeholder="Email address"
                    value="<%= (typeof user !== 'undefined' && user) ? user.email : '' %>" required>
                </div>
              </div>

              <% if (!(typeof user !== 'undefined' && user)) { %>
              <div class="form-group row">
                <label class="col-sm-3 col-form-label">Password</label>
                <div class="col-sm-9">
                  <input type="password" name="pwd" class="form-control" placeholder="Password" required>
                </div>
              </div>
              <% } %>

              <div class="form-group row">
                <label class="col-sm-3 col-form-label">Phone</label>
                <div class="col-sm-9">
                  <input type="text" name="phone" class="form-control" placeholder="Phone number"
                    value="<%= (typeof user !== 'undefined' && user) ? (user.phone || '') : '' %>">
                </div>
              </div>

              <div class="form-group row">
                <label class="col-sm-3 col-form-label">Gender</label>
                <div class="col-sm-9">
                  <select name="gender" class="form-control" required>
                    <option value="">-- Select Gender --</option>
                    <option value="male"   <%= (typeof user !== 'undefined' && user && user.gender === 'male')   ? 'selected' : '' %>>Male</option>
                    <option value="female" <%= (typeof user !== 'undefined' && user && user.gender === 'female') ? 'selected' : '' %>>Female</option>
                    <option value="other"  <%= (typeof user !== 'undefined' && user && user.gender === 'other')  ? 'selected' : '' %>>Other</option>
                  </select>
                </div>
              </div>

              <div class="form-group row">
                <label class="col-sm-3 col-form-label">Date of Birth</label>
                <div class="col-sm-9">
                  <input type="date" name="dob" class="form-control"
                    value="<%= (typeof user !== 'undefined' && user && user.dob) ? user.dob.toISOString().split('T')[0] : '' %>" required>
                </div>
              </div>

              <div class="form-group row">
                <label class="col-sm-3 col-form-label">Role</label>
                <div class="col-sm-9">
                  <select name="role" class="form-control" required>
                    <option value="">-- Select Role --</option>
                    <option value="admin"     <%= (typeof user !== 'undefined' && user && user.role === 'admin')     ? 'selected' : '' %>>Admin</option>
                    <option value="editor"    <%= (typeof user !== 'undefined' && user && user.role === 'editor')    ? 'selected' : '' %>>Editor</option>
                    <option value="moderator" <%= (typeof user !== 'undefined' && user && user.role === 'moderator') ? 'selected' : '' %>>Moderator</option>
                    <option value="user"      <%= (typeof user !== 'undefined' && user && user.role === 'user')      ? 'selected' : '' %>>User</option>
                    <option value="viewer"    <%= (typeof user !== 'undefined' && user && user.role === 'viewer')    ? 'selected' : '' %>>Viewer</option>
                  </select>
                </div>
              </div>

              <div class="form-group row">
                <label class="col-sm-3 col-form-label">City</label>
                <div class="col-sm-9">
                  <input type="text" name="city" class="form-control" placeholder="City"
                    value="<%= (typeof user !== 'undefined' && user) ? user.city : '' %>" required>
                </div>
              </div>

              <div class="form-group row">
                <label class="col-sm-3 col-form-label">Avatar</label>
                <div class="col-sm-9">
                  <% if (typeof user !== 'undefined' && user && user.avatar) { %>
                    <div class="mb-2">
                      <img src="/uploads/<%= user.avatar %>" width="60" height="60"
                           style="border-radius:50%; object-fit:cover; margin-right:10px;">
                      <small class="text-muted">Current avatar</small>
                    </div>
                  <% } %>
                  <input type="file" name="avatar" class="form-control" accept="image/*"
                    <%= (typeof user !== 'undefined' && user) ? '' : 'required' %>>
                  <small class="text-muted">
                    <%= (typeof user !== 'undefined' && user) ? 'Leave blank to keep current avatar.' : 'Upload a profile picture.' %>
                  </small>
                </div>
              </div>

              <div class="form-group row mt-4">
                <div class="col-sm-9 offset-sm-3">
                  <% if (typeof user !== 'undefined' && user) { %>
                    <button type="submit" class="btn btn-success me-2">Update User</button>
                  <% } else { %>
                    <button type="submit" class="btn btn-primary me-2">Add User</button>
                  <% } %>
                  <a href="/users/view" class="btn btn-dark">Cancel</a>
                </div>
              </div>

            </form>
          </div>
        </div>
      </div>
    </div>

  </div><!-- content-wrapper -->
  <%- include('../../partials/footer') %>
</div><!-- main-panel -->
