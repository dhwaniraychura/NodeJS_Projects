<%- include('../../partials/header_auth') %>
<div class="container-scroller">
  <div class="container-fluid page-body-wrapper full-page-wrapper">
    <div class="row w-100">
      <div class="content-wrapper full-page-wrapper d-flex align-items-center auth login-bg">
        <div class="card col-lg-4 mx-auto">
          <div class="card-body px-5 py-5">
            <h3 class="card-title text-start mb-3">Forgot Password</h3>
            <p class="text-muted mb-4">Enter your registered email address and we'll send you an OTP to reset your password.</p>

            <% if (locals.success && success.length > 0) { %>
              <div class="alert alert-success"><%= success[0] %></div>
            <% } %>
            <% if (typeof error !== 'undefined' && error) { %>
              <div class="alert alert-danger"><%= error %></div>
            <% } %>

            <form method="POST" action="/send-otp">
              <div class="form-group">
                <label>Email Address *</label>
                <input type="email" class="form-control p_input" name="email" placeholder="Enter your email" required>
              </div>
              <div class="text-center d-grid gap-2 mt-3">
                <button type="submit" class="btn btn-primary btn-block enter-btn">Send OTP</button>
              </div>
            </form>

            <p class="sign-up mt-3 text-center">
              Remember your password? <a href="/login">Login</a>
            </p>
          </div>
        </div>
      </div>
    </div>
  </div>
</div>
<%- include('../../partials/footer_auth') %>
