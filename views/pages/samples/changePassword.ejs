<!DOCTYPE html>
<html>
<head>
    <%- include('../../partials/header',{title:title}) %>
</head>
<style>
.container-scroller {
    display: flex;
    flex-direction: column;
    min-height: 100vh;
}

.container-fluid.page-body-wrapper {
    display: flex;
    flex: 1;
    padding: 0 !important;
    margin: 0 !important;
    width: 100% !important;
}

.main-panel {
    width: 100% !important;
    flex-grow: 1 !important;
    margin-left: 0 !important;
    padding-left: 0 !important;
}

.content-wrapper {
    width: 100% !important;
    padding: 20px !important;
    margin: 0 !important;
}

.card {
    width: 50%;
}

.sidebar-wrapper, #sidebar, .nav-left-sidebar {
    display: none !important;
}

/* ─── Breadcrumb Styles ─── */
.page-header-section {
    /* background: #ffffff; */
    /* border: 1px solid #e8eaf0; */
    border-radius: 10px;
    padding: 16px 22px;
    margin-bottom: 24px;
    display: flex;
    align-items: center;
    justify-content: space-between;
}

.page-header-left {
    display: flex;
    flex-direction: column;
    gap: 6px;
}

.page-header-title {
    font-size: 18px;
    font-weight: 600;
    color: #2d3748;
    margin: 0;
    display: flex;
    align-items: center;
    gap: 10px;
}

.page-header-title .title-icon {
    width: 34px;
    height: 34px;
    background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
    border-radius: 8px;
    display: flex;
    align-items: center;
    justify-content: center;
    color: #fff;
    font-size: 16px;
    flex-shrink: 0;
}

.custom-breadcrumb {
    display: flex;
    align-items: center;
    gap: 6px;
    list-style: none;
    margin: 0;
    padding: 0;
}

.custom-breadcrumb li {
    display: flex;
    align-items: center;
    gap: 6px;
    font-size: 13px;
}

.custom-breadcrumb li a {
    color: #667eea;
    text-decoration: none;
    font-weight: 500;
    display: flex;
    align-items: center;
    gap: 4px;
    transition: color 0.2s ease;
}

.custom-breadcrumb li a:hover {
    color: #764ba2;
}

.custom-breadcrumb li.active {
    color: #718096;
    font-weight: 500;
}

.custom-breadcrumb .separator {
    color: #cbd5e0;
    font-size: 11px;
}

.page-header-right .header-badge {
    background: #f0f4ff;
    color: #667eea;
    border: 1px solid #d0d9ff;
    border-radius: 20px;
    padding: 5px 14px;
    font-size: 12px;
    font-weight: 600;
    letter-spacing: 0.4px;
}
</style>
<body>

<div class="container-scroller">

    <!-- <%- include('../../partials/navbar') %> -->

    <div class="container-fluid page-body-wrapper">

        <%- include('../../partials/sidebar') %>

        <div class="main-panel">
            <div class="content-wrapper">

                <!-- ─── Page Header + Breadcrumb ─── -->
                <div class="page-header-section">
                    <div class="page-header-left">

                        <h4 class="page-header-title">
                            <span class="title-icon">
                                <i class="mdi mdi-lock-reset"></i>
                            </span>
                            Change Password
                        </h4>

                        <ul class="custom-breadcrumb">
                            <li>
                                <a href="/">
                                    <i class="mdi mdi-home-outline"></i>
                                    Dashboard
                                </a>
                            </li>
                            </li>
                            <li>
                                <span class="separator">
                                    <i class="mdi mdi-chevron-right"></i>
                                </span>
                            </li>
                            <li class="active">
                                <i class="mdi mdi-lock-outline"></i>
                                Change Password
                            </li>
                        </ul>

                    </div>

                </div>

                <!-- ─── Card ─── -->
                <div class="row">
                    <div class="col-12 d-flex justify-content-center align-items-center">
                        <div class="card">
                            <div class="card-body">

                                <h4 class="card-title">Change Password</h4>

                                <% if(error){ %>
                                    <div class="alert alert-danger">
                                        <%= error %>
                                    </div>
                                <% } %>

                                <% if(success){ %>
                                    <div class="alert alert-success">
                                        <%= success %>
                                    </div>
                                <% } %>

                                <form method="POST" action="/change-password">

                                    <div class="form-group">
                                        <label>Old Password</label>
                                        <input
                                            type="password"
                                            name="oldPassword"
                                            class="form-control"
                                            required>
                                    </div>

                                    <div class="form-group">
                                        <label>New Password</label>
                                        <input
                                            type="password"
                                            name="newPassword"
                                            class="form-control"
                                            required>
                                    </div>

                                    <div class="form-group">
                                        <label>Confirm Password</label>
                                        <input
                                            type="password"
                                            name="confirmPassword"
                                            class="form-control"
                                            required>
                                    </div>

                                    <button
                                        type="submit"
                                        class="btn btn-primary">
                                        Change Password
                                    </button>

                                </form>

                            </div>
                        </div>
                    </div>
                </div>

            </div>

            <%- include('../../partials/footer') %>

        </div>
    </div>
</div>

</body>
</html>