<%- include('header') %>

<section class="view-section">
    <div class="container">
        <div class="view-header">
            <h2>🎬 All Movies</h2>
            <a href="/add-movie" class="btn btn-red">+ Add Movie</a>
        </div>

        <% if (movies && movies.length > 0) { %>
        <div class="table-wrap">
            <table class="movie-table">
                <thead>
                    <tr>
                        <th>#</th>
                        <th>Poster</th>
                        <th>Title</th>
                        <th>Year</th>
                        <th>Genre</th>
                        <th>Duration</th>
                        <th>Language</th>
                        <th>Actors</th>
                        <th>Directors</th>
                        <th>Rating</th>
                        <th>Actions</th>
                    </tr>
                </thead>
                <tbody>
                    <% movies.map(function(movie, i) { %>
                    <tr>
                        <td><%= i + 1 %></td>
                        <td>
                            <img src="/assets/uploads/<%= movie.poster %>" alt="<%= movie.title %>">
                        </td>
                        <td style="font-weight:600;"><a href="/movie/<%= movie._id %>" style="color:#fff;text-decoration:none;transition:color 0.2s;" onmouseover="this.style.color='#e50914'" onmouseout="this.style.color='#fff'"><%= movie.title %></a></td>
                        <td><%= movie.releaseYear %></td>
                        <td>
                            <% movie.genre.forEach(function(g) { %>
                                <span class="t-genre-tag"><%= g.trim() %></span>
                            <% }); %>
                        </td>
                        <td><%= movie.duration %></td>
                        <td><%= movie.language.join(', ') %></td>
                        <td><%= movie.actors.join(', ') %></td>
                        <td><%= movie.directors.join(', ') %></td>
                        <td>
                            <span class="rating-badge">⭐ <%= movie.rating %></span>
                        </td>
                        <td>
                            <div class="action-btns">
                                <a href="/edit-movie/<%= movie._id %>" class="btn btn-edit">✏️ Edit</a>
                                <a href="/delete/<%= movie._id %>" class="btn btn-delete" onclick="return confirm('Delete this movie?')">🗑 Delete</a>
                            </div>
                        </td>
                    </tr>
                    <% }); %>
                </tbody>
            </table>
        </div>
        <% } else { %>
        <div class="empty-state">
            <div class="empty-icon">🎥</div>
            <h3>No movies found</h3>
            <p>Start by adding your first movie!</p>
            <a href="/add-movie" class="btn btn-red" style="margin: 0 auto;">+ Add Movie</a>
        </div>
        <% } %>
    </div>
</section>

<%- include('footer') %>
