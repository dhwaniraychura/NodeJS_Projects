<%- include('header') %>

<section class="form-section">
    <div class="container">
        <div class="row justify-center">
            <div class="col-8">
                <div class="form-card">
                    <h2 class="form-card-title">✏️ Edit Movie</h2>
                    <form action="/update-movie/<%= movie._id %>?_method=PUT" method="post" enctype="multipart/form-data">
                        <div class="form-grid">

                            <div class="form-group">
                                <label>Title</label>
                                <input type="text" name="title" value="<%= movie.title %>" required>
                            </div>

                            <div class="form-group">
                                <label>Release Year</label>
                                <input type="text" name="releaseYear" value="<%= movie.releaseYear %>" required>
                            </div>

                            <div class="form-group">
                                <label>Genre</label>
                                <input type="text" name="genre" value="<%= movie.genre.join(', ') %>" required>
                                <span class="form-hint">Comma separated</span>
                            </div>

                            <div class="form-group">
                                <label>Duration</label>
                                <input type="text" name="duration" value="<%= movie.duration %>" required>
                            </div>

                            <div class="form-group">
                                <label>Language</label>
                                <input type="text" name="language" value="<%= movie.language.join(', ') %>" required>
                                <span class="form-hint">Comma separated</span>
                            </div>

                            <div class="form-group">
                                <label>Rating</label>
                                <input type="text" name="rating" value="<%= movie.rating %>" required>
                            </div>

                            <div class="form-group">
                                <label>Actors</label>
                                <input type="text" name="actors" value="<%= movie.actors.join(', ') %>" required>
                                <span class="form-hint">Comma separated</span>
                            </div>

                            <div class="form-group">
                                <label>Directors</label>
                                <input type="text" name="directors" value="<%= movie.directors.join(', ') %>" required>
                                <span class="form-hint">Comma separated</span>
                            </div>

                            <div class="form-group full">
                                <label>Change Poster (optional)</label>
                                <input type="file" name="poster" accept="image/*">
                                <span class="form-hint">Leave empty to keep current poster</span>
                            </div>

                            <div class="form-group full">
                                <label>Description</label>
                                <textarea name="description" required><%= movie.description %></textarea>
                            </div>

                            <div class="form-actions full">
                                <a href="/view-movie" class="btn btn-outline">Cancel</a>
                                <button type="submit" class="btn btn-red">Save Changes</button>
                            </div>

                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</section>

<%- include('footer') %>
