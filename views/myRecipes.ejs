<%- include('partials/head') %>
<%- include('partials/navbar') %>

<div class="container">
  <div class="page-header">
    <div>
      <span class="eyebrow">Your Kitchen</span>
      <h1>My Recipes</h1>
      <p>Every dish you've added to The Hearth Book, ready to edit, refine, or remove.</p>
    </div>
    <a href="/recipes/new" class="btn btn-primary">+ Add a Recipe</a>
  </div>

  <% if (recipes.length === 0) { %>
    <div class="empty-state">
      <h3>No recipes yet</h3>
      <p>You haven't shared any recipes. Start building your collection now.</p>
      <a href="/recipes/new" class="btn btn-primary">+ Add Your First Recipe</a>
    </div>
  <% } else { %>
    <div class="recipe-grid">
      <% recipes.forEach(recipe => { %>
        <div class="recipe-card">
          <img src="<%= recipe.image %>" alt="<%= recipe.title %>" class="recipe-card-image" onerror="this.src='/images/default-recipe.svg'">
          <div class="recipe-card-body">
            <span class="recipe-category"><%= recipe.category %></span>
            <h3><%= recipe.title %></h3>
            <p class="desc"><%= recipe.description %></p>
            <div class="recipe-meta">
              <span>⏱ <%= recipe.cookingTime %></span>
              <span><%= recipe.comments.length %> comment<%= recipe.comments.length !== 1 ? 's' : '' %></span>
            </div>
            <div class="recipe-card-actions">
              <a href="/recipes/<%= recipe._id %>" class="btn btn-secondary btn-sm">View</a>
              <a href="/recipes/<%= recipe._id %>/edit" class="btn btn-secondary btn-sm">Edit</a>
              <form action="/recipes/<%= recipe._id %>?_method=DELETE" method="POST" style="flex-grow:1">
                <button type="submit" class="btn btn-danger btn-sm btn-block" onclick="return confirm('Delete this recipe?')">Delete</button>
              </form>
            </div>
          </div>
        </div>
      <% }) %>
    </div>
  <% } %>
</div>

<%- include('partials/footer') %>
